#!/usr/bin/env node

/**
 * Module dependencies.
 */

var app = require('../app');
var debug = require('debug')('crea-acc-backend:server');
var http = require('http');
let models = require('../models')

/**
 * Get port from environment and store in Express.
 */

var port = normalizePort(process.env.PORT || '3000');
app.set('port', port);

/**
 * Create HTTP server.
 */

var server = http.createServer(app);

/**
 * Tables where insert maldito.sql (and similar seed scripts) assign
 * explicit ids, which leaves Postgres's own SERIAL counter behind.
 * Resynced on every boot so the next app-generated id never collides.
 */
var TABLES_WITH_MANUAL_IDS = ['form.form', 'form.question', 'form.option'];

async function resyncIdSequences() {
  for (const table of TABLES_WITH_MANUAL_IDS) {
    await models.sequelize.query(`
      SELECT setval(
        pg_get_serial_sequence('${table}', 'id'),
        COALESCE((SELECT MAX(id) FROM ${table}), 1)
      )
    `);
  }
}

/**
 * Initialize database (schemas, tables, id sequences) then start listening.
 */

async function start() {
  await models.sequelize.query('CREATE SCHEMA IF NOT EXISTS form');
  await models.sequelize.query('CREATE SCHEMA IF NOT EXISTS app');
  await models.sequelize.sync();
  await resyncIdSequences();

  server.listen(port, '0.0.0.0');
  server.on('error', onError);
  server.on('listening', onListening);
}

start().catch(err => {
  console.error('Failed to initialize server:', err);
  process.exit(1);
});

/**
 * Normalize a port into a number, string, or false.
 */

function normalizePort(val) {
  var port = parseInt(val, 10);

  if (isNaN(port)) {
    // named pipe
    return val;
  }

  if (port >= 0) {
    // port number
    return port;
  }

  return false;
}

/**
 * Event listener for HTTP server "error" event.
 */

function onError(error) {
  if (error.syscall !== 'listen') {
    throw error;
  }

  var bind = typeof port === 'string'
    ? 'Pipe ' + port
    : 'Port ' + port;

  // handle specific listen errors with friendly messages
  switch (error.code) {
    case 'EACCES':
      console.error(bind + ' requires elevated privileges');
      process.exit(1);
      break;
    case 'EADDRINUSE':
      console.error(bind + ' is already in use');
      process.exit(1);
      break;
    default:
      throw error;
  }
}

/**
 * Event listener for HTTP server "listening" event.
 */

function onListening() {
  var addr = server.address();
  var bind = typeof addr === 'string'
    ? 'pipe ' + addr
    : 'port ' + addr.port;
  debug('Listening on ' + bind);
}
